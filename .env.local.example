# See supabase/README.md for how to get these two.
# Server-only — never exposed to the browser. The browser only ever talks to
# our own /api routes, never to Supabase directly, so no anon/public key is needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://api.data.gov/signup (Smithsonian Open Access API).
# The literal string DEMO_KEY works for a quick try but is capped at 30
# requests/hour/IP — get a real key before running a full seed.
SMITHSONIAN_API_KEY=

# Free Personal API key from https://pro.europeana.eu/page/get-api (My
# Profile -> Manage API key -- issued instantly, no approval wait). Only
# needed for --source=europeana or the default --source=all; every other
# source works without it.
EUROPEANA_API_KEY=

# Optional. Comma-separated source_museum values to omit from the deck and the
# liked wall, e.g. HIDDEN_SOURCES=artic. Leave unset to show everything. Useful
# when a museum's image host is unreachable from a particular network -- see the
# image hosting gotchas in the README.
# HIDDEN_SOURCES=
