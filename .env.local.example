# See supabase/README.md for how to get these two.
# Server-only — never exposed to the browser. The browser only ever talks to
# our own /api routes, never to Supabase directly, so no anon/public key is needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://api.data.gov/signup (Smithsonian Open Access API).
# The literal string DEMO_KEY works for a quick try but is capped at 30
# requests/hour/IP — get a real key before running a full seed.
SMITHSONIAN_API_KEY=
